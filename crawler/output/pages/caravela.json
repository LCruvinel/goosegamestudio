  "content": "\n\n\t\t\t\t\n\t\t\t\t\t<div class=\"entry-content\">\n\t\t\t\t\t<div class=\"et-l et-l--post\">\n\t\t\t<div class=\"et_builder_inner_content et_pb_gutters3\">\n\t\t<div id=\"dct_slider_v65\" class=\"et_pb_section et_pb_section_0 et_pb_fullwidth_section et_section_regular\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_fullwidth_slider_0 dct_kenburns_top et_animated et_pb_slider et_pb_slider_no_arrows et_slider_auto et_slider_speed_7000 et_slider_auto_ignore_hover et_pb_bg_layout_dark\" data-active-slide=\"et_pb_slide_0\">\n\t\t\t\t<div class=\"et_pb_slides\">\n\t\t\t\t\t<div class=\"et_pb_slide et_pb_slide_0 et_pb_bg_layout_dark et_pb_slide_with_image et_pb_media_alignment_center et-pb-active-slide\" data-slide-id=\"et_pb_slide_0\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_container clearfix\" style=\"height: 688.438px;\">\n\t\t\t\t\t<div class=\"et_pb_slider_container_inner\">\n\t\t\t\t\t\t<div class=\"et_pb_slide_image\" style=\"margin-top: -124px;\"><img fetchpriority=\"high\" decoding=\"async\" width=\"1299\" height=\"1076\" src=\"https://goosegamestudio.com/wp-content/uploads/GGS-CaravelaLogo1.png\" alt=\"\" srcset=\"https://goosegamestudio.com/wp-content/uploads/GGS-CaravelaLogo1.png 1299w, https://goosegamestudio.com/wp-content/uploads/GGS-CaravelaLogo1-1280x1060.png 1280w, https://goosegamestudio.com/wp-content/uploads/GGS-CaravelaLogo1-980x812.png 980w, https://goosegamestudio.com/wp-content/uploads/GGS-CaravelaLogo1-480x398.png 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) and (max-width: 980px) 980px, (min-width: 981px) and (max-width: 1280px) 1280px, (min-width: 1281px) 1299px, 100vw\" class=\"wp-image-987516379 active\" style=\"max-height: 550.75px;\"></div>\n\t\t\t\t\t\t<div class=\"et_pb_slide_description\">\n\t\t\t\t\t\t\t<h2 class=\"et_pb_slide_title\">Gather, Trade, Win!</h2><div class=\"et_pb_slide_content\"><p data-start=\"181\" data-end=\"352\"><strong data-start=\"181\" data-end=\"248\">Set sail as a daring merchant explorer in the Age of Discovery!</strong><br data-start=\"248\" data-end=\"251\">Command your fleet, trade exotic goods, and outwit rivals as you navigate the world’s great oceans.</p>\n<p data-start=\"354\" data-end=\"546\"><strong data-start=\"354\" data-end=\"432\">From bustling ports to distant horizons, every choice shapes your fortune.</strong><br data-start=\"432\" data-end=\"435\">Will you build a thriving trade empire and earn eternal glory — or see your ambitions sink beneath the waves?</p></div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t<div class=\"et_pb_slide et_pb_slide_1 et_pb_bg_layout_dark et_pb_slide_with_image et_pb_media_alignment_center\" data-slide-id=\"et_pb_slide_1\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_container clearfix\" style=\"height: 688.438px;\">\n\t\t\t\t\t<div class=\"et_pb_slider_container_inner\">\n\t\t\t\t\t\t<div class=\"et_pb_slide_image\"><img fetchpriority=\"high\" decoding=\"async\" width=\"1299\" height=\"1076\" src=\"https://goosegamestudio.com/wp-content/uploads/GGS-CaravelaLogo1.png\" alt=\"\" srcset=\"https://goosegamestudio.com/wp-content/uploads/GGS-CaravelaLogo1.png 1299w, https://goosegamestudio.com/wp-content/uploads/GGS-CaravelaLogo1-1280x1060.png 1280w, https://goosegamestudio.com/wp-content/uploads/GGS-CaravelaLogo1-980x812.png 980w, https://goosegamestudio.com/wp-content/uploads/GGS-CaravelaLogo1-480x398.png 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) and (max-width: 980px) 980px, (min-width: 981px) and (max-width: 1280px) 1280px, (min-width: 1281px) 1299px, 100vw\" class=\"wp-image-987516379\"></div>\n\t\t\t\t\t\t<div class=\"et_pb_slide_description\">\n\t\t\t\t\t\t\t<h2 class=\"et_pb_slide_title\">Master the Spice Trade!</h2><div class=\"et_pb_slide_content\"><p data-start=\"232\" data-end=\"466\">Embark on a voyage of trade, exploration, and strategy in this captivating card game. Balance your fleet’s ambitions with the demands of commerce and fortune, as you compete with rival merchants to dominate the world’s trade routes.</p>\n<p data-start=\"468\" data-end=\"650\">Perfect for both casual and game enthusiasts alike, <strong data-start=\"502\" data-end=\"514\">Caravela</strong> is a test of foresight and courage, where only the most skilled traders will turn the winds of history in their favour.</p></div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t<div class=\"et-pb-controllers\"><a href=\"#\" class=\"et-pb-active-control\">1</a><a href=\"#\">2</a></div></div>\n\t\t\t<div class=\"et_pb_module et_pb_fullwidth_code et_pb_fullwidth_code_0\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_code_inner\"><style>\n  \n  \n  .dct_kenburns_top .et_pb_slide .et_parallax_bg{-webkit-animation:dct_kenburns_top 5s cubic-bezier(.39,.575,.565,1.000) both;animation:dct_kenburns_top 5s cubic-bezier(.39,.575,.565,1.000) both;}\n@-webkit-keyframes dct_kenburns_top{0%{-webkit-transform:scale(1) translateY(0);transform:scale(1) translateY(0);-webkit-transform-origin:50% 16%;transform-origin:50% 16%}100%{-webkit-transform:scale(1.25) translateY(-15px);transform:scale(1.25) translateY(-15px);-webkit-transform-origin:top;transform-origin:top}}@keyframes dct_kenburns_top{0%{-webkit-transform:scale(1) translateY(0);transform:scale(1) translateY(0);-webkit-transform-origin:50% 16%;transform-origin:50% 16%}100%{-webkit-transform:scale(1.25) translateY(-15px);transform:scale(1.25) translateY(-15px);-webkit-transform-origin:top;transform-origin:top}}\n\n  \n#dct_slider_v65 .et_pb_button {\n    text-transform: uppercase;\nfont-size: 16px;\ndisplay: inline-block;\nmargin: 10px;\nbackground: #1c8924;\nborder: none;\npadding: 10px 25px;\nfont-style: normal;\nlett