  "content": "\n\n\t\t\t\t\n\t\t\t\t\t<div class=\"entry-content\">\n\t\t\t\t\t<div class=\"et-l et-l--post\">\n\t\t\t<div class=\"et_builder_inner_content et_pb_gutters3\">\n\t\t<div class=\"et_pb_section et_pb_section_0 et_pb_fullwidth_section et_section_regular\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_fullwidth_slider_0 dct_slider_v9 et_pb_slider et_pb_bg_layout_dark\" data-active-slide=\"et_pb_slide_0\">\n\t\t\t\t<div class=\"et_pb_slides\">\n\t\t\t\t\t<div class=\"et_pb_slide et_pb_slide_0 et_pb_bg_layout_dark et_pb_media_alignment_center et-pb-active-slide\" data-slide-id=\"et_pb_slide_0\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_container clearfix\" style=\"height: 723.422px;\">\n\t\t\t\t\t<div class=\"et_pb_slider_container_inner\">\n\t\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"et_pb_slide_description\">\n\t\t\t\t\t\t\t<h2 class=\"et_pb_slide_title\">Build and Expand Your Kingdom</h2><div class=\"et_pb_slide_content\"><p class=\"text\">Start with a humble city and small forces, then grow your medieval kingdom by constructing buildings, recruiting troops, and expanding your domain.</p>\n<p class=\"text\">Navigate treacherous terrain and defend your lands from barbarian invasions as you assert your dominance in a hostile world</p></div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t<div class=\"et_pb_slide et_pb_slide_1 et_pb_bg_layout_dark et_pb_media_alignment_center\" data-slide-id=\"et_pb_slide_1\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_container clearfix\" style=\"height: 723.422px;\">\n\t\t\t\t\t<div class=\"et_pb_slider_container_inner\">\n\t\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"et_pb_slide_description\">\n\t\t\t\t\t\t\t<h2 class=\"et_pb_slide_title\">Master Strategic Decision-Making</h2><div class=\"et_pb_slide_content\"><p class=\"text\">Island Lords challenges you to balance resource management, tactical combat, and strategic planning.</p>\n<p class=\"text\">Build farms and work camps to sustain your economy, unlock powerful technologies in libraries and universities, and plan your movements carefully across rivers and enemy territories.</p></div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t<div class=\"et_pb_slide et_pb_slide_2 et_pb_bg_layout_dark et_pb_media_alignment_center\" data-slide-id=\"et_pb_slide_2\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_container clearfix\" style=\"height: 723.422px;\">\n\t\t\t\t\t<div class=\"et_pb_slider_container_inner\">\n\t\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"et_pb_slide_description\">\n\t\t\t\t\t\t\t<h2 class=\"et_pb_slide_title\">Achieve Victory Through Multiple Paths</h2><div class=\"et_pb_slide_content\"><p class=\"text\">Choose your path to power by completing two of four quests: military conquest, economic prosperity, population growth, or technological supremacy.</p>\n<p class=\"text\">Each victory condition offers a unique strategy, allowing you to tailor your approach to dominate the competition.</p></div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t<div class=\"et-pb-slider-arrows\"><a class=\"et-pb-arrow-prev\" href=\"#\"><span>Previous</span></a><a class=\"et-pb-arrow-next\" href=\"#\"><span>Next</span></a></div><div class=\"et-pb-controllers\"><a href=\"#\" class=\"et-pb-active-control\">1</a><a href=\"#\">2</a><a href=\"#\">3</a></div></div>\n\t\t\t<div class=\"et_pb_module et_pb_fullwidth_code et_pb_fullwidth_code_0\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_code_inner\"><style>\n\n.dct_slider_v9 .et_pb_slide_description .et_pb_slide_title {\n\tposition: relative;\n\tdisplay: block;\n\tfont-size: 64px;\n\tline-height: 70px;\n\tcolor: #fff;\n\ttext-align: left;\n\tfont-weight: 700;\n\tmax-width: 750px;\n\tpadding-left: 25px;\n\tmargin-bottom: 25px;\n\tobject-position: 0\n}\n\n.dct_slider_v9 .et_pb_slide_description .et_pb_slide_content {\n\tfont-size: 28px;\n\tline-height: 1.2em;\n\tcolor: #fff;\n\tfont-weight: 300;\n\tmargin-bottom: 20px;\n\tposition: relative;\n\ttext-align: left\n}\n\n.dct_slider_v9 .et_pb_button_wrapper {\n\ttext-align: left\n}\n\n.dct_slider_v9 .et_pb_button_wrapper .et_pb_button {\n\tposition: relative;\n\tfont-size: 16px;\n\tz-index: 1;\n\tcolor: #fff;\n\tfont-weight: 500;\n\tpadding: 10px 30px;\n\tbackground-color: #fa7c04;\n\toverflow: hidden;\n\ttransition: all .3s linear;\n\tborder-radius: 3px;\n\tdisplay: inline-block;\n\tborder: none\n}\n\n.dct_slider_v9 .et_pb_button_wrapper .et_pb_button:hover {\n\tcolor: #0076ea;\n\t-webkit-box-shadow: 0 10px 30px rgba(0, 0, 0, .1);\n\t-moz-box-shadow: 0 10px 30px rgba(0, 0, 0, .1);\n\t-ms-box-shadow: 0 10px 30px rgba(0, 0, 0, .1);\n\t-o-box-shadow: 0 10px 30px rgba(0, 0, 0, .1);\n\tbox-shadow: 0 10px 30px rgba(0, 0, 0, .1)\n}\n\n.dct_slider_v9 .et_pb_button_wrapper .et_pb_button:before {\n\tposition: absolute;\n\tleft: 0;\n\tmargin-left: 0;\n\ttop: 0;\n\topacity: 1;\n\tdisplay: block;\n\tvisibility: visible!important;\n\theight: 100%;\n\twidth: 100%;\n\tcontent: \"\";\n\tz-index: -1;\n\tbackground-color: #fff;\n\t-webkit-transform: scale(0, 1);\n\t-ms-transform: scale(0, 1);\n\ttransform: scale(0, 1);\n\t-webkit-transform-origin: top right;\n\t-ms-transform-origin: top right;\n\ttransform-origin: top right;\n\t-webkit-transition: transform .5s cubic-bezier(.86, 0, .070, 1);\n\t-moz-transition: transform .5s cubic-bezier(.86, 0, .070, 1);\n\t-o-transition: transform .5s cubic-bezier(.86, 0, .070, 1);\n\ttransition: transform .5s cubic-bezier(.86, 0, .070, 1);\n\ttransition-timing-function: cubic-bezier(.86, 0, .07, 1);\n\t-webkit-transition-timing-function: cubic-bezier(.86, 0, .070, 1);\n\t-moz-transition-timing-function: cubic-bezier(.86, 0, .070, 1);\n\t-o-transition-timing-function: cubic-bezier(.86, 0, .070, 1);\n\ttransition-timing-function: cubic-bezier(.86, 0, .070, 1)\n}\n\n.dct_slider_v9 .et_pb_button_wrapper .et_pb_button:hover:after {\n\topacity: 0\n}\n\n.dct_slider_v9 .et_pb_button_wrapper .et_pb_button:hover:before {\n\t-webkit-transform: scale(1, 1);\n\t-ms-transform: scale(1, 1);\n\ttransform: scale(1, 1);\n\t-webkit-transform-origin: bottom left;\n\t-ms-transform-origin: bottom left;\n\ttransform-origin: bottom left\n}\n\n.dct_slider_v9 .et_pb_slide_description .et_pb_slide_title:before {\n\tposition: absolute;\n\tleft: 0;\n\ttop: 0;\n\twidth: 5px;\n\tcontent: \"\";\n\tbackground-color: #fa7c04;\n\theight: 100%;\n\ttransition-delay: .5s;\n\ttransition: all .7s ease\n}\n\n.dct_slider_v9 .et-pb-controllers a {\n\twidth: 15px;\n\tbackground: #fff;\n\topacity: 1;\n\tborder-radius: 0;\n\tmargin-right: 6px;\n}\n\n.dct_slider_v9 .et-pb-controllers .et-pb-active-control {\n\twidth: 20px;\n\tbackground: #fa7c04;\n}\n\n.dct_slider_v9 .et-pb-arrow-next,\n.dct_slider_v9 .et-pb-arrow-prev {\n\tbackground: #fa7c04;\n\tfont-size: 35px;\n\tpadding: 15px;\n}\n\n.dct_slider_v9 .et-pb-arrow-prev:before {\n\tcontent: '\\23';\n}\n\n.dct_slider_v9 .et-pb-arrow-next:before {\n\tcontent: '\\24';\n}\n\n.dct_slider_v9:hover .et-pb-arrow-prev {\n\tleft: 0px !important;\n}\n\n.dct_slider_v9:hover .et-pb-arrow-next {\n\tright: 0px !important;\n}\n\n@media only screen and (max-width: 480px) {\n\t.dct_slider_v9 .et-pb-arrow-next,\n\t.dct_slider_v9 .et-pb-arrow-prev {\n\t\tfont-size: 20px;\n\t\tpadding: 5px;\n\t}\n\t.dct_slider_v9 .et_pb_slide_description .et_pb_slide_title {\n\t\tline-height: 35px;\n\t}\n\t.dct_slider_v9 .et_pb_slide_description .et_pb_slide_content {\n\t\ttext-align: center;\n\t}\n\t.dct_slider_v9 .et_pb_button_wrapper {\n\t\ttext-align: center;\n\t\tmargin-bottom: 20px;\n\t}\n}\n\n@media only screen and (max-width: 980px) {\n\t.dct_slider_v9 .et_pb_slide_description .et_pb_slide_title {\n\t\tline-height: auto;\n\t}\n}\n\n\n</style></div>\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div><div class=\"et_pb_section et_pb_section_1 et_pb_equal_columns et_section_specialty\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_row et_pb_gutters2\">\n\t\t\t\t<div class=\"et_pb_column et_pb_column_1_2 et_pb_column_0   et_pb_specialty_column  et_pb_css_mix_blend_mode_passthrough\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_row_inner et_pb_row_inner_0\">\n\t\t\t\t<div class=\"et_pb_column et_pb_column_4_4 et_pb_column_inner et_pb_column_inner_0 et-last-child\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_divider_0 et_pb_space et_pb_divider_hidden\"><div class=\"et_pb_divider_internal\"></div></div>\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t</div><div class=\"et_pb_column et_pb_column_1_2 et_pb_column_1 et_pb_css_mix_blend_mode_passthrough et_pb_column_single\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_text et_pb_text_0  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><h1>Strategic board game for 3 to 5 players</h1></div>\n\t\t\t</div><div class=\"et_pb_module et_pb_divider et_pb_divider_1 et_pb_divider_position_center et_pb_space\"><div class=\"et_pb_divider_internal\"></div></div><div class=\"et_pb_module et_pb_divider et_pb_divider_2 et_pb_divider_position_center et_pb_space\"><div class=\"et_pb_divider_internal\"></div></div><div class=\"et_pb_module et_pb_text et_pb_text_1  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p>Island Lords offers a deeply strategic experience, where every decision matters. The game’s terrain mechanics demand adaptability, while barbarian incursions add an element of unpredictability, ensuring no two games are alike.</p>\n<p>Forge alliances, trade resources, and negotiate technologies as you race to establish dominance over the land.</p></div>\n\t\t\t</div><div class=\"et_pb_module et_pb_accordion et_pb_accordion_0\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_toggle et_pb_module et_pb_accordion_item et_pb_accordion_item_0  et_pb_toggle_open\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<h5 class=\"et_pb_toggle_title\">Your Title Goes Here</h5>\n\t\t\t\t<div class=\"et_pb_toggle_content clearfix\"><p>Your content goes here. Edit or remove this text inline or in the module Content settings. You can also style every aspect of this content in the module Design settings and even apply custom CSS to this text in the module Advanced settings.</p></div>\n\t\t\t</div><div class=\"et_pb_toggle et_pb_module et_pb_accordion_item et_pb_accordion_item_1  et_pb_toggle_close\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<h5 class=\"et_pb_toggle_title\">Deep strategy and replayability</h5>\n\t\t\t\t<div class=\"et_pb_toggle_content clearfix\"><p>Perfect for strategy enthusiasts looking for a nuanced and engaging game.</p></div>\n\t\t\t</div><div class=\"et_pb_toggle et_pb_module et_pb_accordion_item et_pb_accordion_item_2  et_pb_toggle_close\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<h5 class=\"et_pb_toggle_title\">Immersive medieval setting</h5>\n\t\t\t\t<div class=\"et_pb_toggle_content clearfix\"><p>Experience the challenges of ruling a medieval kingdom, from resource optimization to diplomacy and warfare.</p></div>\n\t\t\t</div><div class=\"et_pb_toggle et_pb_module et_pb_accordion_item et_pb_accordion_item_3  et_pb_toggle_close\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<h5 class=\"et_pb_toggle_title\">Compete or collaborate</h5>\n\t\t\t\t<div class=\"et_pb_toggle_content clearfix\"><p>Form alliances or rivalries with other players through the game’s innovative trading and negotiation mechanics.</p></div>\n\t\t\t</div>\n\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t</div><div class=\"et_pb_section et_pb_section_2 et_pb_with_background et_section_regular\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_row et_pb_row_0 et_pb_equal_columns et_pb_gutters2\">\n\t\t\t\t<div class=\"et_pb_column et_pb_column_4_4 et_pb_column_2  et_pb_css_mix_blend_mode_passthrough et-last-child\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_text et_pb_text_2  et_pb_text_align_center et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p>Set in a dynamic, hex-based world of mountains, rivers, and valleys, it offers a unique, three-dimensional environment where every decision matters.</p></div>\n\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div><div class=\"et_pb_row et_pb_row_1 et_pb_equal_columns et_pb_gutters2\">\n\t\t\t\t<div class=\"et_pb_with_border et_pb_column_1_2 et_pb_column et_pb_column_3 et_hover_enabled  et_pb_css_mix_blend_mode_passthrough\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_image et_pb_image_0\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<span class=\"et_pb_image_wrap \"><img fetchpriority=\"high\" decoding=\"async\" width=\"284\" height=\"189\" src=\"https://goosegamestudio.com/wp-content/uploads/1z.png\" alt=\"\" title=\"1z\" class=\"wp-image-258\"></span>\n\t\t\t</div><div class=\"et_pb_module et_pb_text et_pb_text_3  et_pb_text_align_center et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p>Compete for Resources</p></div>\n\t\t\t</div><div class=\"et_pb_module et_pb_text et_pb_text_4  et_pb_text_align_center et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p>Gather what you need to complete a variety of non-exclusive missions. Whether you aim for peaceful resource management or bold tactical maneuvers, the choice is yours.</p></div>\n\t\t\t</div>\n\t\t\t</div><div class=\"et_pb_with_border et_pb_column_1_2 et_pb_column et_pb_column_4 et_hover_enabled  et_pb_css_mix_blend_mode_passthrough et-last-child\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_image et_pb_image_1\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<span class=\"et_pb_image_wrap \"><img loading=\"lazy\" decoding=\"async\" width=\"267\" height=\"271\" src=\"https://goosegamestudio.com/wp-content/uploads/6z.png\" alt=\"\" title=\"6z\" class=\"wp-image-286\"></span>\n\t\t\t</div><div class=\"et_pb_module et_pb_text et_pb_text_5  et_pb_text_align_center et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p>Barbarian Threats</p></div>\n\t\t\t</div><div class=\"et_pb_module et_pb_text et_pb_text_6  et_pb_text_align_center et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p>The mountains aren’t just scenic—they’re spawning grounds for barbarian troops that roam the board, keeping you on your toes. Building up your defenses is essential!</p></div>\n\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div><div class=\"et_pb_row et_pb_row_2 et_pb_equal_columns et_pb_gutters2\">\n\t\t\t\t<div class=\"et_pb_with_border et_pb_column_1_2 et_pb_column et_pb_column_5 et_hover_enabled  et_pb_css_mix_blend_mode_passthrough\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_image et_pb_image_2\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<span class=\"et_pb_image_wrap \"><img loading=\"lazy\" decoding=\"async\" width=\"176\" height=\"117\" src=\"https://goosegamestudio.com/wp-content/uploads/IslandLords-fort.png\" alt=\"\" title=\"IslandLords-fort\" class=\"wp-image-987515835\"></span>\n\t\t\t</div><div class=\"et_pb_module et_pb_text et_pb_text_7  et_pb_text_align_center et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p>Optional Conflict</p></div>\n\t\t\t</div><div class=\"et_pb_module et_pb_text et_pb_text_8  et_pb_text_align_center et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p>Unlike many games, direct competition isn’t mandatory—but it’s always an option! Resources are limited, and sometimes, war might be your best path forward.</p></div>\n\t\t\t</div>\n\t\t\t</div><div class=\"et_pb_with_border et_pb_column_1_2 et_pb_column et_pb_column_6 et_hover_enabled  et_pb_css_mix_blend_mode_passthrough et-last-child\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_image et_pb_image_3\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<span class=\"et_pb_image_wrap \"><img loading=\"lazy\" decoding=\"async\" width=\"166\" height=\"164\" src=\"https://goosegamestudio.com/wp-content/uploads/IslandLords-Windmill.png\" alt=\"\" title=\"IslandLords-Windmill\" class=\"wp-image-987515834\"></span>\n\t\t\t</div><div class=\"et_pb_module et_pb_text et_pb_text_9  et_pb_text_align_center et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p>Dynamic Gameplay</p></div>\n\t\t\t</div><div class=\"et_pb_module et_pb_text et_pb_text_10  et_pb_text_align_center et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p>With sessions lasting between 60 and 120 minutes depending on the number of players, every game is a fresh challenge, ensuring endless replayability.</p></div>\n\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div><div class=\"et_pb_section et_pb_section_3 et_pb_with_background et_section_regular\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_row et_pb_row_3 et_pb_equal_columns et_pb_gutters2 et_pb_row_3-5_1-5_1-5\">\n\t\t\t\t<div class=\"et_pb_column et_pb_column_3_5 et_pb_column_7  et_pb_css_mix_blend_mode_passthrough\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_text et_pb_text_11  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p>Get your game now</p></div>\n\t\t\t</div><div class=\"et_pb_module et_pb_text et_pb_text_12  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><h4>Pre-order online</h4></div>\n\t\t\t</div>\n\t\t\t</div><div class=\"et_pb_column et_pb_column_1_5 et_pb_column_8  et_pb_css_mix_blend_mode_passthrough\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_button_module_wrapper et_pb_button_0_wrapper et_pb_button_alignment_right et_pb_module \">\n\t\t\t\t<a class=\"et_pb_button et_pb_button_0 ctc_slide_btn et_pb_bg_layout_light\" href=\"#contact\" data-icon=\"\">More Info</a>\n\t\t\t</div>\n\t\t\t</div><div class=\"et_pb_column et_pb_column_1_5 et_pb_column_9  et_pb_css_mix_blend_mode_passthrough et-last-child et_pb_column_empty\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\t\t</div>\n\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\n\t\t\t\t",
