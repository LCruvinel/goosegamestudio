max-width: 480px) 480px, (min-width: 481px) and (max-width: 980px) 980px, (min-width: 981px) and (max-width: 1280px) 1280px, (min-width: 1281px) 1600px, 100vw\" class=\"wp-image-987516052\"><span class=\"et_overlay\"></span></span></a>\n\t\t\t</div><div class=\"et_pb_with_border et_pb_module et_pb_image et_pb_image_8 et_pb_has_overlay\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<a href=\"https://goosegamestudio.com/wp-content/uploads/GGSDevTeam-WhatsApp-Image-2025-01-17-at-4.44.18-PM-8.jpeg\" class=\"et_pb_lightbox_image\" title=\"\"><span class=\"et_pb_image_wrap has-box-shadow-overlay\"><div class=\"box-shadow-overlay\"></div><img loading=\"lazy\" decoding=\"async\" width=\"1253\" height=\"641\" src=\"https://goosegamestudio.com/wp-content/uploads/GGSDevTeam-WhatsApp-Image-2025-01-17-at-4.44.18-PM-8.jpeg\" alt=\"\" title=\"GGSDevTeam\" srcset=\"https://goosegamestudio.com/wp-content/uploads/GGSDevTeam-WhatsApp-Image-2025-01-17-at-4.44.18-PM-8.jpeg 1253w, https://goosegamestudio.com/wp-content/uploads/GGSDevTeam-WhatsApp-Image-2025-01-17-at-4.44.18-PM-8-980x501.jpeg 980w, https://goosegamestudio.com/wp-content/uploads/GGSDevTeam-WhatsApp-Image-2025-01-17-at-4.44.18-PM-8-480x246.jpeg 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) and (max-width: 980px) 980px, (min-width: 981px) 1253px, 100vw\" class=\"wp-image-987516050\"><span class=\"et_overlay\"></span></span></a>\n\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div><div class=\"et_pb_section et_pb_section_3 et_pb_with_background et_section_regular\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_row et_pb_row_1\">\n\t\t\t\t<div class=\"et_pb_column et_pb_column_4_4 et_pb_column_5  et_pb_css_mix_blend_mode_passthrough et-last-child\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_code et_pb_code_0\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_code_inner\">\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  const stack = document.querySelector(\".person-img\");\n  const titles = document.querySelectorAll(\".member-info\");\n  const cards = Array.from(stack.children);\n  let currentIndex = 0; // Track the current index of titles\n\n  if (stack) {\n    // Show the default title displayed\n    titles[currentIndex].classList.add(\"active\");\n\n    function updateTitle() {\n      // Remove 'active' class from all titles\n      titles.forEach((title) => title.classList.remove(\"active\"));\n      // Set the active title based on the current index\n      titles[currentIndex].classList.add(\"active\");\n    }\n\n    function moveCard() {\n      const lastCard = stack.lastElementChild;\n      if (lastCard.classList.contains(\"card\")) {\n        lastCard.classList.add(\"swap\");\n\n        setTimeout(() => {\n          lastCard.classList.remove(\"swap\");\n          stack.insertBefore(lastCard, stack.firstElementChild);\n\n          // Update the title index and display the new title\n          currentIndex = (currentIndex + 1) % titles.length; // Cycle through titles\n          updateTitle();\n        }, 1200);\n      }\n    }\n\n    // Set interval for autoplay\n    let autoplayInterval = setInterval(moveCard, 9000);\n\n    // Add click event to swap card on click\n    stack.addEventListener(\"click\", function (e) {\n      const card = e.target.closest(\".card\");\n      if (card && card === stack.lastElementChild) {\n        card.classList.add(\"swap\");\n\n        setTimeout(() => {\n          card.classList.remove(\"swap\");\n          stack.insertBefore(card, stack.firstElementChild);\n\n          // Update the title index and display the new title\n          currentIndex = (currentIndex + 1) % titles.length; // Cycle through titles\n          updateTitle();\n        }, 1200);\n      }\n    });\n  } else {\n    console.error(\"No element with the class 'stack' found.\");\n  }\n});\n</script>\n\n\n</div>\n\t\t\t</div><div class=\"et_pb_module et_pb_code et_pb_code_1\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_code_inner\"><style>\n  /* Here you can change colors */\n\n:root {\n  --color1: #1cb57d;\n  --color2: #293306;\n}\n\n/*Design*/\n\n.member-info .et_pb_team_member_image {\n  border-radius: 50%;\n  overflow: hidden;\n  position: relative;\n  margin: 0 0 20px 0;\n  width: 150px;\n  max-width: 100%;\n}\n\n.member-info .et_pb_team_member_image::before,\n.member-info .et_pb_team_member_image::after {\n  content: \"\";\n  width: 100%;\n  height: 100%;\n  border-radius: 50%;\n  border: 7px solid #e6e5e5;\n  position: absolute;\n  top: 0;\n  left: 0;\n  -webkit-box-sizing: border-box;\n  -moz-box-sizing: border-box;\n  box-sizing: border-box;\n}\n\n.member-info .et_pb_team_member_image:after {\n  border-color: var(--color1) #e6e5e5 #e6e5e5 var(--color1);\n  z-index: 1;\n  transform: rotate(-10deg);\n  transition: all 0.5s ease 0s;\n}\n\n.member-info:hover .et_pb_team_member_image:after {\n  transform: rotate(350deg);\n}\n\n.member-info .et_pb_team_member_image img {\n  width: 100%;\n  aspect-ratio: 1/1;\n  object-fit: cover;\n  padding: 15px;\n  border-radius: 50%;\n}\n\n.member-info .et_pb_team_member_description .et_pb_module_header {\n  position: relative;\n  margin-bottom: 20px;\n  padding-bottom: 12px;\n  width: fit-content;\n}\n\n.member-info .et_pb_team_member_description .et_pb_module_header:before,\n.member-info .et_pb_team_member_description .et_pb_module_header:after {\n  content: \"\";\n  display: block;\n  width: 100%;\n  height: 2px;\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  transition: all 0.3s linear 0s;\n  -webkit-box-sizing: border-box;\n  -moz-box-sizing: border-box;\n  box-sizing: border-box;\n}\n\n.member-info .et_pb_team_member_description .et_pb_module_header:after {\n  background: var(--color2);\n}\n\n.member-info .et_pb_team_member_description .et_pb_module_header:before {\n  background: var(--color1);\n  transform: scale(0);\n  z-index: 1;\n}\n\n.member-info:hover .et_pb_team_member_description .et_pb_module_header:before {\n  transform: scale(1);\n}\n\n.member-info .et_pb_team_member_description .et_pb_member_position {\n  color: var(--color1);\n  padding-bottom: 15px;\n  font-size: 18px;\n}\n\n.member-info .et_pb_team_member_description div a {\n  color: #fff;\n  background: var(--color1);\n  padding: 0 5px;\n  border-radius: 5px;\n}\n\n.member-info .et_pb_team_member_description div strong {\n  color: var(--color2);\n  display: inline-block;\n  font-size: 18px;\n}\n\n.member-info .et_pb_team_member_description ul.et_pb_member_social_links li {\n  margin-right: 10px;\n}\n\n.member-info .et_pb_team_member_description ul.et_pb_member_social_links li a {\n  position: relative;\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background-color: var(--color2);\n  text-align: center;\n  transition: 0.6s;\n  box-shadow: 0 5px 4px rgba(0, 0, 0, 0.5);\n  color: #fff;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n.member-info\n  .et_pb_team_member_description\n  ul.et_pb_member_social_links\n  li:hover\n  a {\n  transform: translate(0, -10%);\n  background-color: var(--color1);\n}\n\n/* =Layout customization starts here= */\n\n#et-fb-app .team-row-stack .card {\n  position: relative !important;\n  transform: none;\n}\n\n.team-row-stack {\n  height: 500px;\n}\n#et-fb-app .team-row-stack {\n  height: 100%; \n}\n\n#et-fb-app .team-row-stack .swap {\n  animation: none;\n}\n  \n  .team-row-stack .person-img{display: flex;\n  flex-direction: column-reverse;}\n\n#et-fb-app .team-row-stack .card .et_pb_image_wrap img {\n  aspect-ratio: 1/1;\n  object-fit: cover;\n}\n\n.team-row-stack .person-info .member-info {\n  display: none; /* Hide all titles by default */\n}\n\n.team-row-stack .person-info .member-info.active,\n#et-fb-app .team-row-stack .person-info .member-info {\n  display: block; /* Show only the active title */\n}\n\n.team-row-stack .person-img {\n  position: relative;\n  \n}\n\n.team-row-stack .card {\n  position: absolute;\n  transform: translate(-50%, -50%);\n  top: 50%;\n  left: 50%;\n  width: 350px;\n  height: 500px;\n  border-radius: 2rem;\n  box-shadow: 0 5px 10px 0 rgba(0, 0, 0, 0.25),\n    0 15px 20px 0 rgba(0, 0, 0, 0.125);\n  transition: transform 0.6s;\n  user-select: none;\n  margin-bottom: 0 !important;\n}\n\n.team-row-stack .card .et_pb_image_wrap {\n  height: 100%;\n  display: block;\n  border-radius: 10px;\n}\n\n.team-row-stack .card img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  border-radius: inherit;\n  object-fit: cover;\n  pointer-events: none;\n}\n\n.team-row-stack .card:nth-last-child(1) img {\n  box-shadow: 0 1px 5px 5px rgba(0, 0, 0, 0.5);\n}\n\n.team-row-stack .swap {\n  animation: swap 1.3s ease-out forwards;\n}\n\n@keyframes swap {\n  30% {\n    transform: translate(-30px, -50%) scale(0.5);\n  }\n  100% {\n    transform: translate(-30px, -50%) scale(0.5);\n    z-index: -1;\n  }\n}\n\n/* Stacked Cards */\n\n.team-row-stack .card:nth-last-child(n + 5) {\n  --x: calc(-50% + 90px);\n  transform: translate(var(--x), -50%) scale(0.85);\n  box-shadow: 0 0 1px 1px rgba(0, 0, 0, 0.01);\n}\n\n.team-row-stack .card:nth-last-child(4) {\n  --x: calc(-50% + 60px);\n  transform: translate(var(--x), -50%) scale(0.9);\n}\n\n.team-row-stack .card:nth-last-child(3) {\n  --x: calc(-50% + 30px);\n  transform: translate(var(--x), -50%) scale(0.95);\n}\n\n.team-row-stack .card:nth-last-child(2) {\n  --x: calc(-50%);\n  transform: translate(var(--x), -50%) scale(1);\n}\n\n.team-row-stack .card:nth-last-child(1) {\n  --x: calc(-50% - 30px);\n  transform: translate(var(--x), -50%) scale(1.05);\n}\n\n@keyframes swap {\n  30% {\n    transform: translate(calc(var(--x) - 250px), -50%) scale(0.85) rotate(-5deg)\n      rotateY(65deg);\n  }\n  100% {\n    transform: translate(calc(var(--x) - 30px), -50%) scale(0.5);\n    z-index: -1;\n  }\n}\n\n/* Media queries for keyframes */\n\n@media (max-width: 1200px) {\n  @keyframes swap {\n    30% {\n      transform: translate(calc(var(--x) - 200px), -50%) scale(0.85)\n        rotate(-5deg) rotateY(65deg);\n    }\n\n    100% {\n      transform: translate(calc(var(--x) - 30px), -50%) scale(0.5);\n      z-index: -1;\n    }\n  }\n}\n\n@media (max-width: 1050px) {\n  @keyframes swap {\n    30% {\n      transform: translate(calc(var(--x) - 150px), -50%) scale(0.85)\n        rotate(-5deg) rotateY(65deg);\n    }\n\n    100% {\n      transform: translate(calc(var(--x) - 30px), -50%) scale(0.5);\n      z-index: -1;\n    }\n  }\n}\n\n/* Media queries for other classes */\n\n@media (max-width: 1200px) {\n  .team-row-stack .person-info {\n    padding: 0 30px 0 0;\n  }\n\n  .team-row-stack .card {\n    width: 250px;\n    height: 380px;\n  }\n  .team-row-stack .person-img {\n    height: 480px;\n  }\n  .team-row-stack {\n    height: 100%;\n  }\n}\n\n@media (max-width: 1050px) {\n  .team-row-stack .person-info {\n    padding-left: 60px;\n  }\n\n  .team-row-stack .card {\n    width: 220px;\n    height: 350px;\n  }\n  .team-row-stack .person-img {\n    height: 450px;\n  }\n}\n\n@media (max-width: 990px) {\n  .team-row-stack .card {\n    width: 200px;\n    height: 300px;\n  }\n\n  .team-row-stack .person-img {\n    height: 400px;\n  }\n}\n\n@media (max-width: 950px) {\n  .team-row-stack .person-info {\n    grid-area: content;\n    padding: 0 50px 0 0;\n  }\n\n  .team-row-stack .person-img {\n    grid-area: stacked;\n  }\n}\n\n@media (max-width: 650px) {\n  .team-row-stack .person-info {\n    padding: 0 15px;\n  }\n\n  .team-row-stack .card {\n    width: 180px;\n    height: 260px;\n  }\n}\n\n@media (max-width: 767px) {\n  .member-info .et_pb_team_member_description {\n    text-align: center;\n  }\n  .member-info .et_pb_team_member_description div strong {\n    font-size: 16px;\n  }\n  .member-info .et_pb_team_member_image {\n    margin: 0 auto 30px;\n  }\n  .member-info .et_pb_team_member_description .et_pb_module_header {\n    margin: 0 auto 20px;\n  }\n}\n\n</style></div>\n\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div><div class=\"et_pb_row et_pb_row_2 team-row-stack et_pb_equal_columns et_pb_gutters4\">\n\t\t\t\t<div class=\"et_pb_column et_pb_column_3_5 et_pb_column_6 person-info  et_pb_css_mix_blend_mode_passthrough\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_team_member et_pb_team_member_0 member-info active clearfix et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_team_member_image et-waypoint et_pb_animation_off\"><img loading=\"lazy\" decoding=\"async\" width=\"685\" height=\"621\" src=\"https://goosegamestudio.com/wp-content/uploads/Corrected.png\" alt=\"Felipe Fulcher Cruvinel\" srcset=\"https://goosegamestudio.com/wp-content/uploads/Corrected.png 685w, https://goosegamestudio.com/wp-content/uploads/Corrected-480x435.png 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) 685px, 100vw\" class=\"wp-image-987516406\"></div>\n\t\t\t\t<div class=\"et_pb_team_member_description\">\n\t\t\t\t\t<h4 class=\"et_pb_module_header\">Felipe Fulcher Cruvinel</h4>\n\t\t\t\t\t<p class=\"et_pb_member_position\">Just a goose!</p>\n\t\t\t\t\t<div><p>I have designed my own board games since the first time I played Monopoly at 8 years old and was determined that I could make it better. I’ve now moved on from Monopoly to new games, and I want you to come with me!</p>\n<p>I lived in the UK for 14 years, emerging with a couple of Master’s Degrees from Saint Andrews and a Bachelor’s in International Relations from Queen Mary in London. Other academic interests include security and foreign policy matters at the global level, applied data analytics in conflict analysis.</p>\n<p><strong>Lead Designer</strong></p></div>\n\t\t\t\t\t<ul class=\"et_pb_member_social_links\"><li><a href=\"#\" class=\"et_pb_font_icon et_pb_facebook_icon\"><span>Facebook</span></a></li><li><a href=\"http://@FCruvi\" class=\"et_pb_font_icon et_pb_twitter_icon\"><span>X</span></a></li><li><a href=\"#\" class=\"et_pb_font_icon et_pb_linkedin_icon\"><span>LinkedIn</span></a></li></ul>\n\t\t\t\t</div>\n\t\t\t</div><div class=\"et_pb_module et_pb_team_member et_pb_team_member_1 member-info  clearfix et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_team_member_image et-waypoint et_pb_animation_off\"><img loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"800\" src=\"https://goosegamestudio.com/wp-content/uploads/1665500365947.jpg\" alt=\"Salvador Vaz Pinto\" srcset=\"https://goosegamestudio.com/wp-content/uploads/1665500365947.jpg 800w, https://goosegamestudio.com/wp-content/uploads/1665500365947-480x480.jpg 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) 800px, 100vw\" class=\"wp-image-987516403\"></div>\n\t\t\t\t<div class=\"et_pb_team_member_description\">\n\t\t\t\t\t<h4 class=\"et_pb_module_header\">Salvador Vaz Pinto</h4>\n\t\t\t\t\t<p class=\"et_pb_member_position\">Another goose!</p>\n\t\t\t\t\t<div><p>I started my first business at the age of 11, selling candy to my schoolmates. Fast forward to today, I hold a Master’s Degree in Industrial Engineering and Management from UL, have worked on forecasting for L’Oréal, and built several online businesses. I also run a YouTube channel and founded a web design &amp; AI chatbots agency.</p>\n<p>These days, my journey feels recursive – back to selling candy, but this time it’s brain candy! A well-designed board game is a true gift to the mind. It enhances social gatherings with role-playing, sparking joy, diplomacy, fun, strategy, and the occasional betrayal! We hope you trust in our commitment to deliver countless hours of good times with those who matter.</p>\n<p><strong>Sales Manager</strong></p></div>\n\t\t\t\t\t<ul class=\"et_pb_member_social_links\"><li><a href=\"#\" class=\"et_pb_font_icon et_pb_facebook_icon\"><span>Facebook</span></a></li><li><a href=\"#\" class=\"et_pb_font_icon et_pb_twitter_icon\"><span>X</span></a></li><li><a href=\"#\" class=\"et_pb_font_icon et_pb_linkedin_icon\"><span>LinkedIn</span></a></li></ul>\n\t\t\t\t</div>\n\t\t\t</div><div class=\"et_pb_module et_pb_team_member et_pb_team_member_2 member-info  clearfix et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_team_member_image et-waypoint et_pb_animation_off\"><img loading=\"lazy\" decoding=\"async\" width=\"400\" height=\"400\" src=\"https://goosegamestudio.com/wp-content/uploads/1517286644232.jpg\" alt=\"Marie Dargent\" class=\"wp-image-987516368\"></div>\n\t\t\t\t<div class=\"et_pb_team_member_description\">\n\t\t\t\t\t<h4 class=\"et_pb_module_header\">Marie Dargent</h4>\n\t\t\t\t\t<p class=\"et_pb_member_position\">A social goose!</p>\n\t\t\t\t\t<div><p><strong>Communications &amp; Production Manager</strong></p></div>\n\t\t\t\t\t<ul class=\"et_pb_member_social_links\"><li><a href=\"#\" class=\"et_pb_font_icon et_pb_facebook_icon\"><span>Facebook</span></a></li><li><a href=\"#\" class=\"et_pb_font_icon et_pb_twitter_icon\"><span>X</span></a></li><li><a href=\"#\" class=\"et_pb_font_icon et_pb_linkedin_icon\"><span>LinkedIn</span></a></li></ul>\n\t\t\t\t</div>\n\t\t\t</div><div class=\"et_pb_module et_pb_team_member et_pb_team_member_3 member-info  clearfix et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_team_member_image et-waypoint et_pb_animation_off\"><img loading=\"lazy\" decoding=\"async\" width=\"895\" height=\"895\" src=\"https://goosegamestudio.com/wp-content/uploads/EnzoS.jpg\" alt=\"Enzo Grimaldi\" srcset=\"https://goosegamestudio.com/wp-content/uploads/EnzoS.jpg 895w, https://goosegamestudio.com/wp-content/uploads/EnzoS-480x480.jpg 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) 895px, 100vw\" class=\"wp-image-987516354\"></div>\n\t\t\t\t<div class=\"et_pb_team_member_description\">\n\t\t\t\t\t<h4 class=\"et_pb_module_header\">Enzo Grimaldi</h4>\n\t\t\t\t\t<p class=\"et_pb_member_position\">A designer goose!</p>\n\t\t\t\t\t<div><p>Architect and urbanist graduated from UFRJ, passionate about games. I combine design and architectural knowledge to create unique visual identities, exploring new forms of interaction and immersion.</p>\n<p>My goal is to enhance the player’s experience through innovative and engaging artwork, making every game visually striking and memorable.</p>\n<p><strong>Art and Design Specialist</strong></p></div>\n\t\t\t\t\t<ul class=\"et_pb_member_social_links\"><li><a href=\"#\" class=\"et_pb_font_icon et_pb_facebook_icon\"><span>Facebook</span></a></li><li><a href=\"#\" class=\"et_pb_font_icon et_pb_twitter_icon\"><span>X</span></a></li><li><a href=\"#\" class=\"et_pb_font_icon et_pb_linkedin_icon\"><span>LinkedIn</span></a></li></ul>\n\t\t\t\t</div>\n\t\t\t</div><div class=\"et_pb_module et_pb_team_member et_pb_team_member_4 member-info  clearfix et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_team_member_image et-waypoint et_pb_animation_off\"><img loading=\"lazy\" decoding=\"async\" width=\"750\" height=\"750\" src=\"https://goosegamestudio.com/wp-content/uploads/GGS-StaffRita1v3.png\" alt=\"Rita Madeira\" srcset=\"https://goosegamestudio.com/wp-content/uploads/GGS-StaffRita1v3.png 750w, https://goosegamestudio.com/wp-content/uploads/GGS-StaffRita1v3-480x480.png 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) 750px, 100vw\" class=\"wp-image-987516410\"></div>\n\t\t\t\t<div class=\"et_pb_team_member_description\">\n\t\t\t\t\t<h4 class=\"et_pb_module_header\">Rita Madeira</h4>\n\t\t\t\t\t<p class=\"et_pb_member_position\">A Marketing Goose!</p>\n\t\t\t\t\t<div><p>I am passionate about marketing strategies, with a background in consumer experience, brand management, and data-driven growth. Before joining Goose Game Studio, I led marketing and loyalty initiatives at companies like Philip Morris International, Henkel, and PepsiCo, specializing in customer insights, digital engagement, and product strategy.</p>\n<p>I work on storytelling, community building, and brand positioning to help connect players with the studio’s creative vision. When not developing campaigns or analyzing player feedback, you’ll probably find me exploring indie titles and discovering new games!</p>\n<p><strong>Marketing Manager</strong></p></div>\n\t\t\t\t\t<ul class=\"et_pb_member_social_links\"><li><a href=\"#\" class=\"et_pb_font_icon et_pb_facebook_icon\"><span>Facebook</span></a></li><li><a href=\"#\" class=\"et_pb_font_icon et_pb_twitter_icon\"><span>X</span></a></li><li><a href=\"#\" class=\"et_pb_font_icon et_pb_linkedin_icon\"><span>LinkedIn</span></a></li></ul>\n\t\t\t\t</div>\n\t\t\t</div><div class=\"et_pb_module et_pb_team_member et_pb_team_member_5 member-info  clearfix et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_team_member_image et-waypoint et_pb_animation_off\"><img loading=\"lazy\" decoding=\"async\" width=\"624\" height=\"545\" src=\"https://goosegamestudio.com/wp-content/uploads/Picture4.jpg\" alt=\"Tomás Leal Pereira\" srcset=\"https://goosegamestudio.com/wp-content/uploads/Picture4.jpg 624w, https://goosegamestudio.com/wp-content/uploads/Picture4-480x419.jpg 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) 624px, 100vw\" class=\"wp-image-634\"></div>\n\t\t\t\t<div class=\"et_pb_team_member_description\">\n\t\t\t\t\t<h4 class=\"et_pb_module_header\">Tomás Leal Pereira</h4>\n\t\t\t\t\t<p class=\"et_pb_member_position\">An artistic goose!</p>\n\t\t\t\t\t<div><p>Specializing in design, Tomás leverages a keen insight and well developed aesthetic instincts to make things look and feel good.</p>\n<p>If you find yourself looking at one of our games and think to yourself “Hmm, that’s one good looking visual component!” then you probably have him to thank!</p>\n<p>While his art does speak for itself, feel free to reach out to him on Instagram if you want to hear from him too</p>\n<p><strong>Art and Design Specialist</strong></p></div>\n\t\t\t\t\t<ul class=\"et_pb_member_social_links\"><li><a href=\"#\" class=\"et_pb_font_icon et_pb_facebook_icon\"><span>Facebook</span></a></li><li><a href=\"#\" class=\"et_pb_font_icon et_pb_twitter_icon\"><span>X</span></a></li><li><a href=\"#\" class=\"et_pb_font_icon et_pb_linkedin_icon\"><span>LinkedIn</span></a></li></ul>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t</div><div class=\"et_pb_column et_pb_column_2_5 et_pb_column_7 person-img  et_pb_css_mix_blend_mode_passthrough et-last-child\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_image et_pb_image_9 card\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<span class=\"et_pb_image_wrap \"><img loading=\"lazy\" decoding=\"async\" width=\"624\" height=\"545\" src=\"https://goosegamestudio.com/wp-content/uploads/Picture4.jpg\" alt=\"divi-team-member-2-1\" title=\"Picture4\" srcset=\"https://goosegamestudio.com/wp-content/uploads/Picture4.jpg 624w, https://goosegamestudio.com/wp-content/uploads/Picture4-480x419.jpg 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) 624px, 100vw\" class=\"wp-image-634\"></span>\n\t\t\t</div><div class=\"et_pb_module et_pb_image et_pb_image_10 card\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<span class=\"et_pb_image_wrap \"><img loading=\"lazy\" decoding=\"async\" width=\"750\" height=\"750\" src=\"https://goosegamestudio.com/wp-content/uploads/GGS-StaffRita1v3.png\" alt=\"divi-team-member-2-1\" title=\"GGS-StaffRita1v3\" srcset=\"https://goosegamestudio.com/wp-content/uploads/GGS-StaffRita1v3.png 750w, https://goosegamestudio.com/wp-content/uploads/GGS-StaffRita1v3-480x480.png 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-